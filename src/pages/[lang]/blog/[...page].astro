---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/react/Navigation.tsx';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const locales = ['cs', 'de', 'es', 'it', 'fr'];
  const POSTS_PER_PAGE = 6;
  const allPosts = (await getCollection('blog'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const paths = [];
  for (const lang of locales) {
    const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
    for (let i = 0; i < totalPages; i++) {
      paths.push({
        params: { lang, page: i === 0 ? undefined : String(i + 1) },
        props: {
          posts: allPosts.slice(i * POSTS_PER_PAGE, (i + 1) * POSTS_PER_PAGE),
          currentPage: i + 1,
          totalPages,
          lang,
        },
      });
    }
  }
  return paths;
}

const { posts, currentPage, totalPages, lang } = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags,
    pubDate: p.data.pubDate.toISOString(),
  }));

const searchIndex = JSON.stringify(allPosts);
---

<BaseLayout
  title="Blog | Marek Dolnicek"
  description="Articles on React, TypeScript, AI integration, and enterprise frontend development by Marek Dolnicek."
>
  <Navigation slot="navigation" client:load currentPath={Astro.url.pathname} />
  <LanguageSwitcher slot="language-switcher" />

  <article class="mx-auto max-w-4xl space-y-6 sm:space-y-8 rounded-3xl border border-white/10 bg-slate-900/80 p-4 sm:p-8 backdrop-blur-md shadow-card">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-400">
      <a href={`/${lang}`} class="hover:text-accent">Home</a> → <span class="text-slate-200">Blog</span>
    </nav>

    <header class="space-y-4">
      <h1 class="text-2xl font-bold text-white sm:text-4xl">Blog</h1>
      <p class="text-sm text-slate-200 sm:text-lg">
        Practical insights from enterprise React development, AI integration, and building maintainable systems.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="relative flex-1 sm:max-w-xs">
          <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="M21 21l-4.35-4.35"/></svg>
          <input
            type="search"
            id="blog-search"
            placeholder="Search articles..."
            class="w-full rounded-full border border-white/10 bg-white/5 py-2 pl-9 pr-4 text-sm text-slate-200 placeholder-slate-400 outline-none transition focus:border-accent/50 focus:ring-1 focus:ring-accent/30"
          />
        </div>
        <a href={`/${lang}/blog/rss.xml`} class="text-sm text-slate-400 hover:text-accent">RSS feed →</a>
      </div>
    </header>

    <div class="grid gap-4 sm:gap-6 sm:grid-cols-2" id="blog-grid">
      {posts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric', month: 'long', day: 'numeric',
        });
        return (
          <a href={`/${lang}/blog/${post.id}`} class="grid-panel flex flex-col gap-3 p-4 sm:p-6 blog-card"
            data-title={post.data.title.toLowerCase()}
            data-desc={post.data.description.toLowerCase()}
            data-tags={post.data.tags.join(' ').toLowerCase()}
            data-id={post.id}
          >
            <time class="text-xs text-slate-400" datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>
            <h2 class="text-lg font-semibold text-white sm:text-xl">{post.data.title}</h2>
            <p class="text-sm text-slate-200 sm:text-base">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mt-auto pt-2">
                {post.data.tags.map((tag) => (
                  <span class="pill text-xs">{tag}</span>
                ))}
              </div>
            )}
          </a>
        );
      })}
    </div>

    <div id="search-empty" class="hidden text-center text-slate-400 text-lg py-12">
      No posts match your search.
    </div>

    {posts.length === 0 && (
      <p class="text-center text-slate-400 text-lg py-12">No posts yet. Check back soon.</p>
    )}

    <nav id="pagination" class:list={['flex items-center justify-center gap-4 pt-8', totalPages <= 1 && 'hidden']} aria-label="Pagination">
      {currentPage > 1 && (
        <a href={currentPage === 2 ? `/${lang}/blog` : `/${lang}/blog/${currentPage - 1}`} class="pill hover:border-accent/60">
          ← Previous
        </a>
      )}
      <span class="text-sm text-slate-400">
        Page {currentPage} of {totalPages}
      </span>
      {currentPage < totalPages && (
        <a href={`/${lang}/blog/${currentPage + 1}`} class="pill hover:border-accent/60">
          Next →
        </a>
      )}
    </nav>
  </article>

  <script define:vars={{ searchIndex }}>
    const searchInput = document.getElementById('blog-search');
    const grid = document.getElementById('blog-grid');
    const emptyMsg = document.getElementById('search-empty');
    const pagination = document.getElementById('pagination');
    const cards = grid.querySelectorAll('.blog-card');
    const allPosts = JSON.parse(searchIndex);

    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase();
      let visible = 0;

      if (!q) {
        cards.forEach(c => c.style.display = '');
        grid.querySelectorAll('.search-extra').forEach(el => el.remove());
        emptyMsg.classList.add('hidden');
        pagination?.classList.remove('hidden');
        return;
      }

      const existingIds = new Set();
      cards.forEach(card => {
        const match = card.dataset.title.includes(q)
          || card.dataset.desc.includes(q)
          || card.dataset.tags.includes(q);
        if (match) {
          card.style.display = '';
          visible++;
          existingIds.add(card.dataset.id);
        } else {
          card.style.display = 'none';
        }
      });

      const extraMatches = allPosts.filter(p =>
        !existingIds.has(p.id) && (
          p.title.toLowerCase().includes(q)
          || p.description.toLowerCase().includes(q)
          || p.tags.join(' ').toLowerCase().includes(q)
        )
      );

      grid.querySelectorAll('.search-extra').forEach(el => el.remove());
      extraMatches.forEach(p => {
        const a = document.createElement('a');
        const prefix = window.location.pathname.split('/').filter(Boolean)[0];
        a.href = '/' + prefix + '/blog/' + p.id;
        a.className = 'grid-panel flex flex-col gap-3 p-4 sm:p-6 blog-card search-extra';
        a.dataset.id = p.id;
        const date = new Date(p.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        a.innerHTML = `
          <time class="text-xs text-slate-400">${date}</time>
          <h2 class="text-lg font-semibold text-white sm:text-xl">${p.title}</h2>
          <p class="text-sm text-slate-200 sm:text-base">${p.description}</p>
          ${p.tags.length ? '<div class="flex flex-wrap gap-2 mt-auto pt-2">' + p.tags.map(t => '<span class="pill text-xs">' + t + '</span>').join('') + '</div>' : ''}
        `;
        grid.appendChild(a);
        visible++;
      });

      emptyMsg.classList.toggle('hidden', visible > 0);
      pagination?.classList.add('hidden');
    });
  </script>
</BaseLayout>
