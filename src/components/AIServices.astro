---
import { ui, useTranslations } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const services = [
  { title: t('services.consulting.title'), description: t('services.consulting.description') },
  { title: t('services.integration.title'), description: t('services.integration.description') },
  { title: t('services.agents.title'), description: t('services.agents.description') }
];
---

<section id="services" class="surface-card space-y-6">
  <div class="space-y-3">
    <p class="eyebrow">{t('services.eyebrow')}</p>
    <h2 class="text-3xl font-semibold text-white">{t('services.title')}</h2>
    <p class="max-w-4xl text-lg text-slate-200">{t('services.intro')}</p>
  </div>
  <ul class="grid gap-4 md:grid-cols-3">
    {services.map((service) => (
      <li class="rounded-3xl border border-white/10 bg-white/5 p-5">
        <h3 class="text-xl font-semibold text-white">{service.title}</h3>
        <p class="mt-3 text-slate-300">{service.description}</p>
      </li>
    ))}
  </ul>
  <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{t('services.audience')}</p>
</section>
