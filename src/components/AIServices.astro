---
import { ui, useTranslations } from '../i18n/ui';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props as Props;
const t = useTranslations(lang);

const services = [
  {
    title: t('services.consulting.title'),
    description: t('services.consulting.description'),
    icon: 'M4 19.5V20h.5L17 7.5 14.5 5 2 17.5V20h2zm9-13 2.5 2.5M6 15l3 3M16 3h5m-2.5-2.5v5'
  },
  {
    title: t('services.integration.title'),
    description: t('services.integration.description'),
    icon: 'M8 12h8M5 8a4 4 0 1 0 0 8m14-8a4 4 0 1 1 0 8M9 4h6M9 20h6'
  },
  {
    title: t('services.agents.title'),
    description: t('services.agents.description'),
    icon: 'M8 9h8a4 4 0 0 1 4 4v5H4v-5a4 4 0 0 1 4-4zm4 0V5m-2-2h4M8 14v1m8-1v1'
  }
];
---

<section id="services" class="ai-services surface-card space-y-6">
  <div class="space-y-3">
    <p class="eyebrow">{t('services.eyebrow')}</p>
    <h2 class="text-3xl font-semibold text-white">{t('services.title')}</h2>
    <p class="max-w-4xl text-lg text-slate-200">{t('services.intro')}</p>
  </div>
  <ul class="grid gap-4 md:grid-cols-3">
    {services.map((service) => (
      <li class="service-card">
        <span class="service-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d={service.icon}></path>
          </svg>
        </span>
        <h3 class="text-xl font-semibold text-white">{service.title}</h3>
        <p class="mt-3 text-slate-300">{service.description}</p>
      </li>
    ))}
  </ul>
  <p class="audience-line text-sm font-semibold uppercase tracking-[0.18em] text-accent">
    <span aria-hidden="true">✦</span>{t('services.audience')}
  </p>
</section>
