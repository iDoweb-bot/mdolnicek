---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { title, description, pubDate, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Blog`} description={description}>
  <article class="mx-auto w-full max-w-3xl space-y-8 rounded-3xl border border-white/10 bg-slate-900/80 p-4 sm:p-8 backdrop-blur-md shadow-card">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-400">
      <a href="/" class="hover:text-accent">Home</a> → <a href="/blog" class="hover:text-accent">Blog</a> → <span class="text-slate-200">{title}</span>
    </nav>

    <header class="space-y-3">
      <time class="text-xs text-slate-400" datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
      <h1 class="text-2xl font-bold text-white sm:text-4xl">{title}</h1>
      <p class="text-base text-slate-200 sm:text-lg">{description}</p>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="pill text-xs">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-invert max-w-none prose-headings:text-white prose-p:text-slate-200 prose-a:text-accent prose-code:text-accent prose-pre:bg-slate-800 prose-pre:border prose-pre:border-white/10">
      <slot />
    </div>

    <footer class="border-t border-white/10 pt-6">
      <a href="/blog" class="text-sm font-semibold text-accent hover:text-accentMuted">
        ← Back to blog
      </a>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  .prose { overflow-wrap: break-word; }
  .prose h1 { @apply text-2xl font-bold mb-4 mt-8 sm:text-3xl sm:mb-6 sm:mt-10; }
  .prose h2 { @apply text-xl font-semibold mb-3 mt-6 sm:text-2xl sm:mb-4 sm:mt-8; }
  .prose h3 { @apply text-lg font-semibold mb-2 mt-5 sm:text-xl sm:mb-3 sm:mt-6; }
  .prose p { @apply mb-4 leading-relaxed; }
  .prose ul { @apply mb-4 list-disc pl-5 space-y-1 sm:pl-6; }
  .prose ol { @apply mb-4 list-decimal pl-5 space-y-1 sm:pl-6; }
  .prose li { @apply leading-relaxed text-sm sm:text-base; }
  .prose a { @apply underline underline-offset-2 transition hover:text-accentMuted; }
  .prose code { @apply text-xs px-1 py-0.5 rounded bg-white/10 font-mono sm:text-sm sm:px-1.5 sm:py-0.5; }
  .prose pre { @apply rounded-xl p-3 overflow-x-auto mb-4 sm:p-4 sm:mb-6; }
  .prose pre code { @apply bg-transparent p-0 text-inherit; }
  .prose blockquote { @apply border-l-2 border-accent/50 pl-3 italic text-slate-300 my-4 sm:pl-4 sm:my-6; }
  .prose img { @apply rounded-xl my-4 w-full sm:my-6; }
  .prose hr { @apply border-white/10 my-6 sm:my-8; }
  .prose table { @apply w-full mb-4 text-sm sm:mb-6; }
  .prose th { @apply text-left text-xs font-semibold text-slate-300 pb-2 border-b border-white/10 sm:text-sm; }
  .prose td { @apply text-xs text-slate-200 py-2 border-b border-white/5 sm:text-sm; }

  /* Prevent any table from overflowing on mobile */
  .prose table { @apply block overflow-x-auto; }
</style>
